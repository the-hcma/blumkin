#!/usr/bin/env bash
# .github/ci/ helper: does a pull request touch anything that can affect the Rust build?
# Reads the changed file names (one per line) on stdin and prints `true` or `false`. ci.yml
# runs the macOS Rust job only on `true`, since that runner is scarce and slow and a docs or
# Python change cannot affect it (issue #570). An empty list means the changed files could
# not be read, so it fails safe to `true`.
set -euo pipefail

relevant='^(rust-agent/|hatch_build\.py$|pyproject\.toml$|\.github/ci/rust-(static|changed)$|\.github/workflows/ci\.yml$)'

seen=0
while IFS= read -r file; do
  [[ -n "${file}" ]] || continue
  seen=1
  if [[ "${file}" =~ ${relevant} ]]; then
    echo true
    exit 0
  fi
done

if [[ "${seen}" -eq 0 ]]; then
  echo true
else
  echo false
fi
