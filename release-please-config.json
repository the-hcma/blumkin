{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "blumkin",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='blumkin')].version"
        }
      ]
    },
    "integrations/pi": {
      "release-type": "node",
      "package-name": "@the-hcma/blumkin-pi-skill",
      "component": "blumkin-pi-skill"
    }
  }
}
